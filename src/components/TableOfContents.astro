---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  variant: 'mobile' | 'desktop';
}

const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const link = 'block py-0.5 text-mute hover:text-ink data-[active]:text-ink transition-colors';
---

{items.length >= 3 && (
  variant === 'mobile' ? (
    <details class="lg:hidden mb-8 border border-hairline p-4 text-sm">
      <summary class="cursor-pointer text-mute hover:text-ink">[ contents ]</summary>
      <ol class="mt-3 list-none p-0 m-0">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a href={`#${h.slug}`} class={link}>{h.text}</a>
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <aside class="hidden lg:block w-[200px] shrink-0 self-start sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto text-sm" aria-label="Table of contents">
      <p class="mb-2 text-mute">[ contents ]</p>
      <ol class="toc list-none p-0 m-0 border-l border-hairline">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-6' : 'pl-3'}>
            <a href={`#${h.slug}`} class={link}>{h.text}</a>
          </li>
        ))}
      </ol>
    </aside>
  )
)}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const id = (a: HTMLAnchorElement) => decodeURIComponent(a.hash.slice(1));
  if (links.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.toggleAttribute('data-active', id(a) === e.target.id));
      }),
      { rootMargin: '-80px 0px -70% 0px' }
    );
    links.forEach((a) => { const h = document.getElementById(id(a)); if (h) io.observe(h); });
  }
</script>
