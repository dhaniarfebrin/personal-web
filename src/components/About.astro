---
const techStack = [
  'React',
  'Astro',
  'TypeScript',
  'Tailwind CSS',
  'JavaScript',
  'HTML & CSS',
  'Next.js',
  'Vue.js',
  'Git',
  'Figma',
  'Web Design',
  'UI/UX',
];
---

<section class="bg-canvas border-t border-hairline py-section px-6">
  <div class="max-w-content mx-auto">

    {/* Section Header */}
    <div class="pb-3 mb-8 border-b border-hairline">
      <h2 class="text-heading-md text-ink">About Me</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      {/* Text Content */}
      <div class="space-y-4">
        <p class="text-sm text-body leading-relaxed">
          I'm a frontend developer with a keen eye for detail and a love for creating
          functional user interfaces. I've worked on projects ranging from small startups
          to larger organizations.
        </p>
        <p class="text-sm text-body leading-relaxed">
          My journey started with a curiosity about how websites work, which evolved into
          a full-fledged career. I'm constantly learning and staying updated with the
          latest technologies and best practices.
        </p>
        <p class="text-sm text-body leading-relaxed">
          When not coding, you can find me exploring new design trends, contributing to
          open-source projects, or sharing knowledge with the developer community.
        </p>
      </div>

      {/* Tech Stack — list-row style */}
      <div>
        <h3 class="text-sm font-bold text-ink mb-4">Tech Stack</h3>
        <div class="border-t border-hairline">
          {techStack.map((tech) => (
            <div class="flex items-center gap-3 py-2 border-b border-hairline">
              <span class="text-xs text-mute">[+]</span>
              <span class="text-sm text-ink">{tech}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
