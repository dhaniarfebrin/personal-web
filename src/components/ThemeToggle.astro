---
// ThemeToggle.astro
// Cycles through: system → light → dark → system → ...
---

<button
  id="theme-toggle"
  class="text-sm text-mute hover:text-ink transition-colors duration-150 tabular-nums"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <span id="theme-label">[ sys ]</span>
</button>

<script is:inline>
  (function () {
    var CYCLE = ['system', 'light', 'dark'];
    var LABELS = { system: '[ sys ]', light: '[ \u2600 ]', dark: '[ \u263e ]' };

    function getStored() {
      var val = localStorage.getItem('theme');
      if (val === 'light' || val === 'dark' || val === 'system') return val;
      return 'system';
    }

    function applyTheme(theme) {
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var isDark = theme === 'dark' || (theme === 'system' && prefersDark);
      document.documentElement.classList.toggle('dark', isDark);
    }

    function updateLabel(theme) {
      var el = document.getElementById('theme-label');
      if (el) el.textContent = LABELS[theme];
    }

    function setup() {
      var current = getStored();
      applyTheme(current);
      updateLabel(current);

      var btn = document.getElementById('theme-toggle');
      if (!btn) return;

      // Remove old listener by cloning the button
      var fresh = btn.cloneNode(true);
      btn.parentNode.replaceChild(fresh, btn);

      fresh.addEventListener('click', function () {
        var cur = getStored();
        var nextIndex = (CYCLE.indexOf(cur) + 1) % CYCLE.length;
        var next = CYCLE[nextIndex];
        localStorage.setItem('theme', next);
        applyTheme(next);
        // Update label on the fresh button's span
        var lbl = fresh.querySelector('#theme-label');
        if (lbl) lbl.textContent = LABELS[next];
      });
    }

    // OS-level change listener (only register once)
    if (!window.__themeMediaRegistered) {
      window.__themeMediaRegistered = true;
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
        if (getStored() === 'system') applyTheme('system');
      });
    }

    // Run on every page load / Astro navigation
    setup();
    document.addEventListener('astro:after-swap', setup);
  })();
</script>
