---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '/#contact' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-canvas border-b border-hairline">
  <div class="max-w-content mx-auto px-6 h-14 flex items-center justify-between">
    {/* ASCII Wordmark / Logo */}
    <a href="/" class="text-ink font-bold text-sm tracking-tight hover:opacity-70 transition-opacity">
      [ DF ]
    </a>

    {/* Navigation Links */}
    <div class="flex items-center gap-4 md:gap-6">
      {/* Mobile menu: native <details>, no JS needed */}
      <details class="md:hidden group">
        <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer text-sm text-mute hover:text-ink transition-colors duration-150">
          <span class="group-open:hidden">[ menu ]</span>
          <span class="hidden group-open:inline">[ x ]</span>
        </summary>
        <ul class="absolute top-14 left-0 right-0 bg-canvas border-b border-hairline px-6 py-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                onclick="this.closest('details').removeAttribute('open')"
                class={`block py-2 text-sm ${
                  currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                    ? 'text-ink font-bold'
                    : 'text-mute hover:text-ink'
                }`}
              >
                [-] {link.label}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <ul class="hidden md:flex gap-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`text-sm transition-opacity duration-150 ${
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-ink font-bold'
                  : 'text-mute hover:text-ink'
              }`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      {/* Theme Toggle */}
      <ThemeToggle />

      {/* Resume Button — button-primary style */}
      <a
        href="#"
        class="px-5 py-1 bg-ink text-canvas text-sm font-medium rounded-sm hover:bg-ink-deep transition-colors duration-150"
      >
        Resume
      </a>
    </div>
  </div>
</nav>
