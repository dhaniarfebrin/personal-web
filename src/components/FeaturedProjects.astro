---
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.slice(0, 3);
---

<section
  id="projects"
  class="bg-canvas border-t border-hairline py-section px-6"
>
  <div class="max-w-content mx-auto">
    {/* Section Header */}
    <div
      class="flex items-baseline justify-between mb-8 pb-3 border-b border-hairline"
    >
      <h2 class="text-heading-md text-ink">Featured Projects</h2>
      <a
        href="/projects"
        class="text-caption-md text-mute hover:text-ink transition-colors duration-150"
      >
        View all →
      </a>
    </div>

    {
      featuredProjects.length === 0 ? (
        <div class="py-8 border-b border-hairline">
          <p class="text-sm text-mute">[-] No projects yet. Check back soon.</p>
        </div>
      ) : (
        <div>
          {featuredProjects.map((project) => (
            <div class="group relative py-5 border-b border-hairline hover:bg-surface-soft transition-colors duration-150 -mx-3 px-3">
              <div class="flex items-start gap-3">
                <span class="text-sm text-mute mt-0.5 shrink-0">[+]</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline justify-between gap-4 flex-wrap">
                    {/*
                      Link judul di-stretch pakai after pseudo-element
                      sehingga seluruh baris bisa diklik tanpa nested <a>
                    */}
                    <h3 class="text-sm font-bold text-ink">
                      <a
                        href={`/projects/${project.slug}`}
                        class="after:absolute after:inset-0 group-hover:underline"
                      >
                        {project.data.title}
                      </a>
                    </h3>
                    {/* Tech tags inline */}
                    <div class="flex gap-2 flex-wrap">
                      {project.data.technologies
                        .slice(0, 3)
                        .map((tech: string) => (
                          <span class="text-xs text-mute">{tech}</span>
                        ))}
                      {project.data.technologies.length > 3 && (
                        <span class="text-xs text-mute">
                          +{project.data.technologies.length - 3}
                        </span>
                      )}
                    </div>
                  </div>
                  <p class="text-sm text-body mt-1 line-clamp-2">
                    {project.data.description}
                  </p>

                  {/* Links — z-index lebih tinggi agar klik tidak diambil alih after pseudo-element */}
                  <div class="relative z-10 flex gap-4 mt-3">
                    {project.data.githubUrl && (
                      <a
                        href={project.data.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-mute hover:text-ink underline transition-colors"
                      >
                        [code]
                      </a>
                    )}
                    {project.data.liveUrl && (
                      <a
                        href={project.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-mute hover:text-ink underline transition-colors"
                      >
                        [demo]
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
