---
import { techStack } from '../data/techStack';

const heroStack = techStack.slice(0, 5);
---

<section class="bg-canvas pt-section pb-section px-6">
  <div
    class="max-w-content mx-auto w-full grid md:grid-cols-2 gap-16 items-start"
  >
    {/* Left Column — Text Content */}
    <div class="space-y-8">
      {/* Badge / Eyebrow */}
      <div>
        <span class="text-sm text-mute">[ portfolio ]</span>
      </div>

      {/* Headline — display-xl: 38px / 700 */}
      <h1 class="text-[38px] font-bold leading-[1.5] text-ink">
        Dhaniar Febrin
      </h1>

      {/* Subtitle */}
      <p class="text-body-md text-body leading-relaxed">
        Frontend Developer based in Yogyakarta, Indonesia. I build front ends
        for large-scale enterprise platforms with React and React Native,
        turning complex workflows into structured interfaces: process editors,
        dynamic forms, micro-frontends and shared UI component libraries.
      </p>

      {/* Tech Stack — list-row style */}
      <div class="space-y-0 border-t border-hairline">
        {
          heroStack.map((tech) => (
            <div class="flex items-center gap-3 py-2 border-b border-hairline">
              <span class="text-sm text-mute">[+]</span>
              <span class="text-sm text-ink">{tech}</span>
            </div>
          ))
        }
      </div>

      {/* CTA */}
      <div class="flex gap-3 flex-wrap">
        <a
          href="#projects"
          class="inline-flex items-center min-h-11 px-5 bg-ink text-canvas text-sm font-medium rounded-sm hover:bg-ink-deep transition-colors duration-150"
        >
          View my work
        </a>
        <a
          href="#contact"
          class="inline-flex items-center min-h-11 px-5 bg-canvas text-ink text-sm font-medium rounded-sm border border-hairline-strong hover:bg-surface-soft transition-colors duration-150"
        >
          Get in touch
        </a>
      </div>
    </div>

    {/* Right Column — TUI Mockup */}
    <div class="hidden md:block">
      {
        /* Option A: TUI stays dark in both modes. In dark mode a hairline border
          makes it visible against the matching-dark canvas background. */
      }
      <div
        class="bg-surface-dark rounded-none p-8 font-mono border border-transparent dark:border-hairline-strong"
      >
        {/* ASCII Wordmark */}
        <div
          class="text-canvas text-xs leading-tight mb-8 select-none overflow-x-auto"
        >
          <pre
            class="text-canvas dark:text-[#ece8e6] opacity-90">
 ██████╗ ███████╗
 ██╔══██╗██╔════╝
 ██║  ██║█████╗
 ██║  ██║██╔══╝
 ██████╔╝██║
 ╚═════╝ ╚═╝

 DHANIAR FEBRIN
 FRONTEND DEVELOPER</pre>
        </div>

        {/* TUI Prompt Row */}
        <div class="bg-surface-dark-elevated rounded-sm px-3 py-2 mb-6">
          <p class="text-canvas dark:text-[#ece8e6] text-sm">
            <span class="dark:text-mute text-ash">$</span> whoami
            <span class="dark:text-mute text-ash ml-2">Frontend Developer</span>
          </p>
        </div>

        {/* Status rows */}
        <div class="space-y-1 mb-6">
          <div class="flex items-center gap-2 text-xs dark:text-mute text-ash">
            <span class="text-success">[+]</span>
            <span>Yogyakarta, Indonesia</span>
          </div>
          <div class="flex items-center gap-2 text-xs dark:text-mute text-ash">
            <span class="text-success">[+]</span>
            <span>React, React Native, TypeScript</span>
          </div>
          <div class="flex items-center gap-2 text-xs dark:text-mute text-ash">
            <span class="text-success">[+]</span>
            <span>BPMN editor, form builder, micro-frontends</span>
          </div>
          <div class="flex items-center gap-2 text-xs dark:text-mute text-ash">
            <span class="text-warning">[~]</span>
            <span>Building BPMN AI Studio</span>
          </div>
        </div>

        {/* Keybinding hints */}
        <div class="border-t border-surface-dark-elevated pt-3">
          <p class="text-xs dark:text-mute text-ash">
            [ since 2020 ] building for the web
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
