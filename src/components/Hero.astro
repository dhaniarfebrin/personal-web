---
const techStack = ['React', 'Astro', 'TypeScript', 'Tailwind CSS'];
---

<section class="reveal relative min-h-screen flex items-center justify-center px-6 overflow-hidden">
  {/* Ambient Glowing Background */}
  <div class="absolute inset-0 -z-10">
    {/* Glow Blob 1 - Top Left */}
    <div class="absolute -top-20 -left-32 w-96 h-96 bg-violet-500/20 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-glow-1"></div>
    
    {/* Glow Blob 2 - Bottom Right */}
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-500/20 rounded-full mix-blend-multiply filter blur-3xl opacity-40 animate-glow-2"></div>
    
    {/* Glow Blob 3 - Center */}
    <div class="absolute top-1/3 left-1/2 w-80 h-80 bg-indigo-500/10 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-glow-3"></div>
  </div>

  {/* Main Content Grid */}
  <div class="max-w-7xl mx-auto w-full grid md:grid-cols-2 gap-12 items-center relative z-10">
    {/* Left Column - Text Content */}
    <div class="space-y-8">
      {/* Greeting */}
      <p class="text-violet-400 font-medium text-lg animate-fade-in">
        Hi, welcome to my portfolio
      </p>

      {/* Main Title */}
      <h1 class="text-6xl md:text-7xl font-bold leading-tight animate-fade-in">
        I'm <span class="bg-gradient-to-r from-violet-400 to-violet-500 bg-clip-text text-transparent">
          Dhaniar Febrin
        </span>
      </h1>

      {/* Dynamic Subtitle with Typing Effect */}
      <div class="h-12 md:h-16">
        <p class="text-2xl md:text-3xl text-slate-400 font-light animate-fade-in min-h-fit">
          <span id="typing-text">I build innovative web experiences</span><span id="cursor" class="animate-pulse">|</span>
        </p>
      </div>

      {/* Description */}
      <p class="text-lg text-slate-400 leading-relaxed animate-fade-in">
        I'm a frontend developer specializing in building exceptional digital experiences. Currently focused on crafting fast, accessible, and modern user interfaces with cutting-edge technologies.
      </p>

      {/* CTA Button */}
      <a
        href="#projects"
        class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-violet-600 to-violet-500 text-white rounded-lg font-semibold hover:shadow-lg hover:shadow-violet-500/50 transition-all duration-300 transform hover:-translate-y-2 animate-fade-in"
      >
        Check out my work
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

    {/* Right Column - Visual & Tech Badges */}
    <div class="relative hidden md:flex items-center justify-center">
      {/* Glassmorphic Container */}
      <div class="relative w-full aspect-square max-w-md">
        {/* Main Glass Card */}
        <div class="absolute inset-0 bg-slate-800/30 backdrop-blur-xl border border-slate-700/50 rounded-3xl flex items-center justify-center overflow-hidden group">
          {/* Inner Glow */}
          <div class="absolute inset-0 bg-gradient-to-br from-violet-500/10 to-purple-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          {/* Placeholder Content */}
          <div class="relative z-10 text-center">
            <div class="w-24 h-24 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-violet-500/20 to-purple-500/20 flex items-center justify-center border border-violet-500/30">
              <span class="text-4xl">👨‍💻</span>
            </div>
            <p class="text-slate-300 text-sm font-medium">Frontend Developer</p>
          </div>
        </div>

        {/* Floating Tech Badges */}
        {techStack.map((tech, index) => (
          <div 
            key={tech}
            class={`absolute px-3 py-2 bg-slate-800/60 backdrop-blur-md border border-slate-700/50 rounded-lg text-sm font-medium text-slate-300 hover:border-violet-500/50 transition-all duration-300 animate-float-${index % 3}`}
            style={`
              top: ${25 + (index % 2) * 30}%;
              ${index % 2 === 0 ? 'right: -20px;' : 'left: -20px;'}
            `}
          >
            {tech}
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* Scroll Indicator */}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex justify-center">
    <div class="animate-bounce">
      <svg class="w-6 h-6 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>

  {/* Typing Effect Script */}
  <script>
    const textSequence = [
      'I build innovative web experiences',
      'I craft fast user interfaces',
      'I love web performance',
      'I create beautiful designs'
    ];

    let currentIndex = 0;
    let isDeleting = false;
    let charIndex = 0;
    const typingSpeed = 50;
    const deletingSpeed = 30;
    const pauseDuration = 2000;

    function typeEffect() {
      const element = document.getElementById('typing-text');
      if (!element) return;

      const currentText = textSequence[currentIndex];

      if (!isDeleting) {
        if (charIndex < currentText.length) {
          element.textContent = currentText.substring(0, charIndex + 1);
          charIndex++;
          setTimeout(typeEffect, typingSpeed);
        } else {
          isDeleting = true;
          setTimeout(typeEffect, pauseDuration);
        }
      } else {
        if (charIndex > 0) {
          element.textContent = currentText.substring(0, charIndex - 1);
          charIndex--;
          setTimeout(typeEffect, deletingSpeed);
        } else {
          isDeleting = false;
          currentIndex = (currentIndex + 1) % textSequence.length;
          setTimeout(typeEffect, 500);
        }
      }
    }

    // Initialize on page load
    typeEffect();

    // Reinitialize on Astro navigation
    document.addEventListener('astro:after-swap', () => {
      currentIndex = 0;
      charIndex = 0;
      isDeleting = false;
      typeEffect();
    });
  </script>
</section>
