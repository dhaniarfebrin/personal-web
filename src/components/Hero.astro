---
const techStack = ['React', 'Astro', 'TypeScript', 'Tailwind CSS'];
---

<section class="bg-canvas pt-section pb-section px-6">
  <div class="max-w-content mx-auto w-full grid md:grid-cols-2 gap-16 items-start">

    {/* Left Column — Text Content */}
    <div class="space-y-8">

      {/* Badge / Eyebrow */}
      <div>
        <span class="text-sm text-mute">[ portfolio ]</span>
      </div>

      {/* Headline — display-xl: 38px / 700 */}
      <h1 class="text-[38px] font-bold leading-[1.5] text-ink">
        Dhaniar Febrin
      </h1>

      {/* Subtitle */}
      <p class="text-body-md text-body leading-relaxed">
        Frontend developer specializing in building fast, accessible, and modern user interfaces.
        Currently focused on crafting exceptional digital experiences with cutting-edge web technologies.
      </p>

      {/* Tech Stack — list-row style */}
      <div class="space-y-0 border-t border-hairline">
        {techStack.map((tech) => (
          <div class="flex items-center gap-3 py-2 border-b border-hairline">
            <span class="text-sm text-mute">[+]</span>
            <span class="text-sm text-ink">{tech}</span>
          </div>
        ))}
      </div>

      {/* CTA */}
      <div class="flex gap-3 flex-wrap">
        <a
          href="#projects"
          class="px-5 py-2 bg-ink text-canvas text-sm font-medium rounded-sm hover:bg-ink-deep transition-colors duration-150"
        >
          View my work
        </a>
        <a
          href="#contact"
          class="px-5 py-2 bg-canvas text-ink text-sm font-medium rounded-sm border border-hairline-strong hover:bg-surface-soft transition-colors duration-150"
        >
          Get in touch
        </a>
      </div>
    </div>

    {/* Right Column — TUI Mockup */}
    <div class="hidden md:block">
      <div class="bg-surface-dark rounded-none p-8 font-mono">

        {/* ASCII Wordmark */}
        <div class="text-canvas text-xs leading-tight mb-8 select-none overflow-x-auto">
          <pre class="text-canvas opacity-90">
 ██████╗ ███████╗
 ██╔══██╗██╔════╝
 ██║  ██║█████╗
 ██║  ██║██╔══╝
 ██████╔╝██║
 ╚═════╝ ╚═╝

 DHANIAR FEBRIN
 FRONTEND DEVELOPER</pre>
        </div>

        {/* TUI Prompt Row */}
        <div class="bg-surface-dark-elevated rounded-sm px-3 py-2 mb-6">
          <p class="text-canvas text-sm">
            <span class="text-ash">|</span> Build portfolio
            <span class="text-ash ml-2">Claude Sonnet &nbsp; React + Astro</span>
          </p>
        </div>

        {/* File list rows */}
        <div class="space-y-1 mb-6">
          <div class="flex items-center gap-2 text-xs text-ash">
            <span class="text-success">[+]</span>
            <span>Hero section redesigned</span>
          </div>
          <div class="flex items-center gap-2 text-xs text-ash">
            <span class="text-success">[+]</span>
            <span>Manpage-style typography</span>
          </div>
          <div class="flex items-center gap-2 text-xs text-ash">
            <span class="text-warning">[~]</span>
            <span>Projects section in progress</span>
          </div>
        </div>

        {/* Keybinding hints */}
        <div class="border-t border-surface-dark-elevated pt-3">
          <p class="text-xs text-ash">
            [ tab ] switch &nbsp;&nbsp; [ ctrl-p ] commands
          </p>
        </div>

      </div>
    </div>

  </div>
</section>
