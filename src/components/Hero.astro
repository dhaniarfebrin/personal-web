---
---

<section class="reveal min-h-screen flex items-center justify-center px-6">
  <div class="max-w-4xl mx-auto text-center">
    {/* Greeting */}
    <p class="text-violet-400 font-medium mb-4 text-lg animate-fade-in">
      Hi, welcome to my portfolio
    </p>

    {/* Main Title */}
    <h1 class="text-6xl md:text-7xl font-bold mb-6 leading-tight animate-fade-in">
      I'm <span class="bg-gradient-to-r from-violet-400 to-violet-500 bg-clip-text text-transparent">
        Dhaniar Febrin
      </span>
    </h1>

    {/* Subtitle */}
    <p class="text-2xl md:text-3xl text-slate-400 mb-8 font-light animate-fade-in">
      I build innovative web experiences
    </p>

    {/* Description */}
    <p class="text-lg text-slate-400 max-w-2xl mx-auto mb-12 leading-relaxed animate-fade-in">
      I'm a frontend developer specializing in building exceptional digital experiences. Currently focused on crafting fast, accessible, and modern user interfaces with cutting-edge technologies.
    </p>

    {/* CTA Button */}
    <a
      href="#projects"
      class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-violet-600 to-violet-500 text-white rounded-lg font-semibold hover:shadow-lg hover:shadow-violet-500/50 transition-all duration-300 transform hover:-translate-y-2"
    >
      Check out my work
      <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>

    {/* Scroll Indicator */}
    <div class="mt-20 flex justify-center">
      <div class="animate-bounce">
        <svg class="w-6 h-6 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>
  </div>
</section>
