---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: 'GitHub', href: 'https://github.com/dhaniarfebrin' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/dhaniar' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog', href: '/blog' },
];
---

<footer class="bg-canvas border-t border-hairline py-8 mt-section">
  <div class="max-w-content mx-auto px-6">
    {/* Link Row */}
    <div class="flex flex-wrap gap-0 mb-6 border border-hairline divide-x divide-hairline w-fit">
      {footerLinks.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="px-4 py-2 text-caption-md text-mute hover:text-ink transition-colors duration-150"
        >
          {link.label}
        </a>
      ))}
    </div>

    {/* Bottom row */}
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-2">
      <p class="text-caption-md text-mute">
        &copy;{currentYear} Dhaniar Febrin
      </p>
      <p class="text-caption-md text-mute">
        Built with Astro &amp; Tailwind CSS
      </p>
    </div>
  </div>
</footer>
