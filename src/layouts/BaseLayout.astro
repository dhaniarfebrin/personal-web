---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  currentPath?: string;
}

const { title, description, image, type = 'website', publishedAt, currentPath = '/' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedImage = image ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#201d1d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Dhaniar Febrin" />
    {resolvedImage && <meta property="og:image" content={resolvedImage} />}
    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={resolvedImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedImage && <meta name="twitter:image" content={resolvedImage} />}

    <!-- JetBrains Mono from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- CSS Design Tokens: Light and Dark Mode variables -->
    <style is:global>
      :root {
        --color-canvas: #f8f6f3;
        --color-ink: #201d1d;
        --color-ink-deep: #0f0000;
        --color-charcoal: #302c2c;
        --color-body: #424245;
        --color-mute: #646262;
        --color-stone: #6e6e73;
        --color-ash: #9a9898;
        --color-surface-soft: #f0ece6;
        --color-surface-card: #e9e4dd;
        --color-hairline: rgba(15, 0, 0, 0.12);
        --color-hairline-strong: #646262;
        color-scheme: light;
      }

      .dark {
        color-scheme: dark;
        --color-canvas: #201d1d;
        --color-ink: #ece8e6;
        --color-ink-deep: #f5f2f0;
        --color-charcoal: #e8e4e4;
        --color-body: #d1d1d1;
        --color-mute: #9a9898;
        --color-stone: #8e8e93;
        --color-ash: #6e6e73;
        --color-surface-soft: #302c2c;
        --color-surface-card: #3d3838;
        --color-hairline: rgba(253, 252, 252, 0.12);
        --color-hairline-strong: #9a9898;
      }

      * {
        font-family: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace,
          SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono',
          'Courier New', monospace;
      }

      /* Shiki dual theme (defaultColor: false): light by default, dark via .dark */
      .astro-code,
      .astro-code span {
        color: var(--shiki-light);
      }
      .astro-code {
        background-color: var(--color-surface-soft);
        border: 1px solid var(--color-hairline);
      }
      .dark .astro-code,
      .dark .astro-code span {
        color: var(--shiki-dark);
      }
      .dark .astro-code {
        background-color: var(--shiki-dark-bg);
      }

      /* Contrast fixes (WCAG AA 4.5:1) for Shiki github-light/dark tokens.
         Shiki in Astro 4.16 does not pass colorReplacements, so override by token value. */
      :root:not(.dark) .astro-code span[style*='--shiki-light:#E36209' i] {
        color: #a54a04;
      }
      :root:not(.dark) .astro-code span[style*='--shiki-light:#22863A' i] {
        color: #1b7332;
      }
      :root:not(.dark) .astro-code span[style*='--shiki-light:#D73A49' i] {
        color: #c4283a;
      }
      :root:not(.dark) .astro-code span[style*='--shiki-light:#6A737D' i] {
        color: #5f6872;
      }
      .dark .astro-code span[style*='--shiki-dark:#6A737D' i] {
        color: #959da5;
      }

      /* Copy button lives on a non-scrolling wrapper so it stays put when the <pre> scrolls */
      .code-block {
        position: relative;
      }
      .code-block > pre {
        margin: 0;
        padding-top: 2.5rem;
      }
      .copy-btn {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        height: 1.5rem;
        box-sizing: border-box;
        padding: 0 0.375rem;
        font-size: 0.75rem;
        color: var(--color-mute);
        background: var(--color-canvas);
        border: 1px solid var(--color-hairline);
        border-radius: 4px;
        cursor: pointer;
      }
      /* Invisible hit area: 44px tall tap target, visual stays small */
      .copy-btn::after {
        content: '';
        position: absolute;
        inset: -12px -4px;
      }
      .copy-btn:hover,
      .copy-btn:focus-visible {
        color: var(--color-ink);
      }

      /* Keep tall phone screenshots from filling the whole page */
      .prose img {
        max-height: 70vh;
        width: auto;
        margin-inline: auto;
      }

      /* Wide tables scroll inside their own block instead of breaking the page gutter */
      .prose table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
      }
    </style>

    <!--
      Anti-FOUC: must run synchronously before the page renders.
      1. Check localStorage for a saved preference.
      2. Fall back to OS preference (prefers-color-scheme).
      3. Apply .dark to <html> immediately if needed.
    -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark =
          saved === 'dark' || (saved === null && prefersDark) || (saved === 'system' && prefersDark);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        // Keep theme-color in sync with the effective theme (manual toggle overrides the media queries)
        const syncThemeColor = () => {
          const color = document.documentElement.classList.contains('dark') ? '#201d1d' : '#f8f6f3';
          document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', color));
        };
        syncThemeColor();
        new MutationObserver(syncThemeColor).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      })();
    </script>

    <script>
      document.querySelectorAll('pre.astro-code').forEach((pre) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block';
        wrapper.style.margin = getComputedStyle(pre).margin;
        pre.replaceWith(wrapper);
        wrapper.appendChild(pre);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = '[copy]';
        btn.setAttribute('aria-label', 'Copy code to clipboard');
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? pre.textContent ?? '');
            btn.textContent = '[copied]';
          } catch {
            btn.textContent = '[failed]';
          }
          setTimeout(() => (btn.textContent = '[copy]'), 1500);
        });
        wrapper.appendChild(btn);
      });
    </script>
  </head>

  <body class="bg-canvas text-ink min-h-screen flex flex-col antialiased">
    <Navbar currentPath={currentPath} />
    <main class="flex-1 pt-14">
      <slot />
    </main>
    <Footer />
  </body>
</html>
