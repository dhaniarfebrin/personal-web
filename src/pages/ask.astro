---
import BaseLayout from '../layouts/BaseLayout.astro';
import AskApp from '../components/ask/AskApp.tsx';
---

<BaseLayout
  title="Ask me - Dhaniar Febrin"
  description="Ask questions about Dhaniar Febrin's experience, projects and writing. Answers are generated by AI from this site's content."
  currentPath="/ask"
>
  <div class="bg-canvas py-section px-6">
    <div class="max-w-content mx-auto">
      <div class="pb-3 mb-8 border-b border-hairline">
        <p class="text-xs text-mute mb-1">[ ask ]</p>
        <h1 class="text-heading-md text-ink">[+] ask about my work</h1>
        <p class="text-sm text-body mt-1">
          Answers are generated by AI from this site's content. Powered by DeepSeek — don't share personal data.
        </p>
      </div>
      <AskApp client:load />
    </div>
  </div>
</BaseLayout>
