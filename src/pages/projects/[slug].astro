---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout
  title={`${project.data.title} - Projects`}
  description={project.data.description}
  image={project.data.image}
  currentPath="/projects"
>
  <article class="bg-canvas py-section px-6">
    <div class="max-w-content mx-auto">

      {/* Breadcrumb */}
      <nav class="mb-8">
        <a href="/projects" class="text-xs text-mute hover:text-ink underline transition-colors">
          ← projects
        </a>
      </nav>

      {/* Project Header */}
      <header class="pb-6 mb-8 border-b border-hairline">
        {project.data.featured && (
          <p class="text-xs text-mute mb-2">[featured]</p>
        )}
        <h1 class="text-[38px] font-bold text-ink leading-[1.5] mb-3">
          {project.data.title}
        </h1>
        <p class="text-sm text-body leading-relaxed mb-6">
          {project.data.description}
        </p>

        {/* Action Buttons */}
        <div class="flex flex-wrap gap-3 mb-6">
          {project.data.liveUrl && (
            <a
              href={project.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2 bg-ink text-canvas text-sm font-medium rounded-sm hover:bg-ink-deep transition-colors duration-150"
            >
              [demo] View Live
            </a>
          )}
          {project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2 bg-canvas text-ink text-sm font-medium rounded-sm border border-hairline-strong hover:bg-surface-soft transition-colors duration-150"
            >
              [code] Source Code
            </a>
          )}
        </div>

        {/* Tech Stack */}
        <div>
          <p class="text-xs text-mute mb-2">Technologies</p>
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            {project.data.technologies.map((tech: string) => (
              <span class="text-sm text-ink">{tech}</span>
            ))}
          </div>
        </div>
      </header>

      {/* Featured Image */}
      {project.data.image && (
        <figure class="mb-8 border border-hairline overflow-hidden">
          <img
            src={project.data.image}
            alt={project.data.title}
            class="w-full h-auto object-cover"
          />
        </figure>
      )}

      {/* Project Content */}
      <div class="prose max-w-none">
        <Content />
      </div>

      {/* Back navigation */}
      <nav class="mt-12 pt-6 border-t border-hairline">
        <a href="/projects" class="text-sm text-ink underline hover:opacity-70 transition-opacity">
          ← Back to all projects
        </a>
      </nav>

    </div>
  </article>
</BaseLayout>
