---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort(
  (a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0),
);
---

<BaseLayout
  title="Projects - Dhaniar Febrin"
  description="A collection of projects showcasing my skills and experience in frontend development."
  currentPath="/projects"
>
  <div class="bg-canvas py-section px-6">
    <div class="max-w-content mx-auto">

      {/* Page Header */}
      <div class="pb-3 mb-8 border-b border-hairline">
        <p class="text-xs text-mute mb-1">[ projects ]</p>
        <h1 class="text-heading-md text-ink">My Projects</h1>
        <p class="text-sm text-body mt-1">
          A collection of projects showcasing my skills and experience.
        </p>
      </div>

      {/* Projects List */}
      {projects.length === 0 ? (
        <div class="py-8 border-b border-hairline">
          <p class="text-sm text-mute">[-] No projects yet. Check back soon.</p>
        </div>
      ) : (
        <div>
          {projects.map((project) => (
            <div class="group relative py-5 border-b border-hairline hover:bg-surface-soft transition-colors duration-150 -mx-3 px-3">
              <div class="flex items-start gap-3">
                <span class="text-sm text-mute mt-0.5 shrink-0">[+]</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline justify-between gap-4 flex-wrap">
                    <h2 class="text-sm font-bold text-ink">
                      <a
                        href={`/projects/${project.slug}`}
                        class="after:absolute after:inset-0 group-hover:underline"
                      >
                        {project.data.title}
                      </a>
                    </h2>
                    {/* Tech tags */}
                    <div class="flex gap-2 flex-wrap">
                      {project.data.technologies.slice(0, 3).map((tech: string) => (
                        <span class="text-xs text-mute">{tech}</span>
                      ))}
                      {project.data.technologies.length > 3 && (
                        <span class="text-xs text-mute">
                          +{project.data.technologies.length - 3}
                        </span>
                      )}
                    </div>
                  </div>
                  <p class="text-sm text-body mt-1 line-clamp-2">
                    {project.data.description}
                  </p>
                  {/* Links */}
                  <div class="relative z-10 flex gap-4 mt-3">
                    {project.data.githubUrl && (
                      <a
                        href={project.data.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-mute hover:text-ink underline transition-colors"
                      >
                        [code]
                      </a>
                    )}
                    {project.data.liveUrl && (
                      <a
                        href={project.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-mute hover:text-ink underline transition-colors"
                      >
                        [demo]
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}

    </div>
  </div>
</BaseLayout>
