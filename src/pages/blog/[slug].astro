---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const readTime = Math.ceil(post.body.split(' ').length / 200);
---

<BaseLayout title={`${post.data.title} - Blog`} currentPath="/blog">
  <article class="bg-canvas py-section px-6">
    <div class="max-w-content mx-auto">

      {/* Breadcrumb */}
      <nav class="mb-8">
        <a href="/blog" class="text-xs text-mute hover:text-ink underline transition-colors">
          ← blog
        </a>
      </nav>

      {/* Article Header */}
      <header class="pb-6 mb-8 border-b border-hairline">
        <h1 class="text-[38px] font-bold text-ink leading-[1.5] mb-4">
          {post.data.title}
        </h1>

        {/* Metadata */}
        <div class="flex flex-wrap items-center gap-3 text-xs text-mute">
          <time datetime={post.data.publishedAt.toISOString()}>
            {post.data.publishedAt.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span>·</span>
          <span>{readTime} min read</span>
          {post.data.tags && post.data.tags.length > 0 && (
            <>
              <span>·</span>
              {post.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </>
          )}
        </div>
      </header>

      {/* Featured Image */}
      {post.data.image && (
        <figure class="mb-8 border border-hairline overflow-hidden">
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-auto object-cover"
          />
        </figure>
      )}

      {/* Article Content */}
      <div class="prose max-w-none">
        <Content />
      </div>

      {/* Author attribution */}
      <footer class="mt-12 pt-6 border-t border-hairline">
        <p class="text-xs text-mute">--- Written by Dhaniar Febrin · Frontend Developer</p>
      </footer>

      {/* Back navigation */}
      <nav class="mt-6">
        <a href="/blog" class="text-sm text-ink underline hover:opacity-70 transition-opacity">
          ← Back to all articles
        </a>
      </nav>

    </div>
  </article>
</BaseLayout>
