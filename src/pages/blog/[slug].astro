---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import TableOfContents from '../../components/TableOfContents.astro';
import { readTime } from '../../utils/readTime';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout
  title={`${post.data.title} - Blog`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedAt={post.data.publishedAt}
  currentPath="/blog"
>
  <article class="bg-canvas py-section px-6">
    <div class="max-w-content mx-auto">

      {/* Breadcrumb */}
      <nav class="mb-8">
        <a href="/blog" class="text-xs text-mute hover:text-ink underline transition-colors">
          ← blog
        </a>
      </nav>

      {/* Article Header */}
      <header class="pb-6 mb-8 border-b border-hairline">
        <h1 class="text-[26px] md:text-[38px] font-bold text-ink leading-tight mb-4">
          {post.data.title}
        </h1>

        {/* Metadata */}
        <div class="flex flex-wrap items-center gap-3 text-xs text-mute">
          <time datetime={post.data.publishedAt.toISOString()}>
            {post.data.publishedAt.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span>·</span>
          <span>{readTime(post.body)} min read</span>
          {post.data.tags && post.data.tags.length > 0 && (
            <>
              <span>·</span>
              {post.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </>
          )}
        </div>
      </header>

      {/* Featured Image */}
      {post.data.image && (
        <figure class="mb-8 border border-hairline overflow-hidden">
          <img
            src={post.data.image}
            alt={post.data.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="max-h-[40vh] md:max-h-[70vh] w-auto max-w-full mx-auto"
          />
        </figure>
      )}

      {/* Article Content */}
      <TableOfContents headings={headings} variant="mobile" />
      <div class="lg:flex lg:gap-8 lg:justify-between">
        <div class="article-body prose min-w-0 max-w-[68ch] lg:flex-1">
          <Content />
        </div>
        <TableOfContents headings={headings} variant="desktop" />
      </div>

      {/* Author attribution */}
      <footer class="mt-12 pt-6 border-t border-hairline">
        <p class="text-xs text-mute">--- Written by Dhaniar Febrin · Frontend Developer</p>
      </footer>

      {/* Prev / next */}
      {(newer || older) && (
        <nav class="mt-6 flex justify-between gap-6 text-sm" aria-label="Artikel lain">
          {older ? (
            <a href={`/blog/${older.slug}`} class="text-ink underline hover:opacity-70 transition-opacity">
              ← {older.data.title}
            </a>
          ) : <span />}
          {newer ? (
            <a href={`/blog/${newer.slug}`} class="text-ink underline hover:opacity-70 transition-opacity text-right">
              {newer.data.title} →
            </a>
          ) : <span />}
        </nav>
      )}

      {/* Back navigation */}
      <nav class="mt-6 flex justify-between gap-6 text-sm">
        <a href="/blog" class="text-ink underline hover:opacity-70 transition-opacity">
          ← Back to all articles
        </a>
        <a href="#top" class="text-mute hover:text-ink transition-colors">[ ↑ top ]</a>
      </nav>

    </div>
  </article>
</BaseLayout>

<style>
  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 5rem;
  }
</style>
