---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  title="Blog - Dhaniar Febrin"
  description="Articles about frontend development, web design, and tech tips by Dhaniar Febrin."
  currentPath="/blog"
>
  <div class="bg-canvas py-section px-6">
    <div class="max-w-content mx-auto">

      {/* Page Header */}
      <div class="pb-3 mb-8 border-b border-hairline">
        <p class="text-xs text-mute mb-1">[ blog ]</p>
        <h1 class="text-heading-md text-ink">Writing & Thoughts</h1>
        <p class="text-sm text-body mt-1">
          Articles about frontend development, web design, and tech tips.
        </p>
      </div>

      {/* Post List */}
      {posts.length === 0 ? (
        <div class="py-8 border-b border-hairline">
          <p class="text-sm text-mute">[-] No articles yet. Check back soon.</p>
        </div>
      ) : (
        <div>
          {posts.map((post) => {
            const readTime = Math.ceil(post.body.split(' ').length / 200);
            return (
              <div class="group relative py-5 border-b border-hairline hover:bg-surface-soft transition-colors duration-150 -mx-3 px-3">
                <div class="flex items-start gap-3">
                  <span class="text-sm text-mute mt-0.5 shrink-0">[-]</span>
                  <div class="flex-1 min-w-0">
                    <h2 class="text-sm font-bold text-ink">
                      <a
                        href={`/blog/${post.slug}`}
                        class="after:absolute after:inset-0 group-hover:underline"
                      >
                        {post.data.title}
                      </a>
                    </h2>
                    <p class="text-sm text-body mt-1 line-clamp-2">
                      {post.data.description}
                    </p>
                    {/* Metadata row */}
                    <div class="flex flex-wrap items-center gap-3 mt-2">
                      <time
                        datetime={post.data.publishedAt.toISOString()}
                        class="text-xs text-mute"
                      >
                        {post.data.publishedAt.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                      <span class="text-xs text-mute">·</span>
                      <span class="text-xs text-mute">{readTime} min read</span>
                      {post.data.tags && post.data.tags.length > 0 && (
                        <>
                          <span class="text-xs text-mute">·</span>
                          <div class="relative z-10 flex gap-2 flex-wrap">
                            {post.data.tags.slice(0, 3).map((tag) => (
                              <span class="text-xs text-mute">#{tag}</span>
                            ))}
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}

    </div>
  </div>
</BaseLayout>
